# ---------------------------------------------------------------------------
# AgroProcure Backend — Supabase configuration
# Copy this file to `.env` and fill in your real Supabase project values.
# The backend reads ONLY the variables below; it does NOT use DATABASE_URL.
# ---------------------------------------------------------------------------

# Your Supabase project URL, e.g.  https://abcdefghijklm.supabase.co
SUPABASE_URL=""

# Use the Service Role key for full backend access (recommended for a server).
# The code falls back to SUPABASE_PUBLISHABLE_KEY if SECRET_KEY is not set.
SUPABASE_SECRET_KEY=""
# SUPABASE_PUBLISHABLE_KEY=""

# Optional: override the default listen port
# PORT=8000
